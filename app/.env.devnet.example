# Hourly on Solana devnet. Copy to .env (or pass as env) to run the app against devnet.
# Localnet stays the default in .env: CLUSTER=localnet, RPC_URL=http://127.0.0.1:18899.
CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
PORT=7992
# Switchboard Crossbar (feed storage and oracle quotes). Override if Switchboard moves it again.
CROSSBAR_URL=https://crossbar.switchboard.xyz
# Venue state per cluster lives in state/<cluster>.json (gitignored).
